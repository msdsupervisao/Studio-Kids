# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Armazenamento de arquivos (video, miniatura, avatar...) — "supabase" (padrao)
# ou "r2" (Cloudflare R2, ver services/storage/r2.ts). So preencher as
# variaveis R2_* quando NEXT_PUBLIC_STORAGE_PROVIDER=r2.
NEXT_PUBLIC_STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Ativa a tela de manutencao pra todo mundo (ver /manutencao) — usado
# durante a migracao de armazenamento, sem precisar reverter com deploy.
MAINTENANCE_MODE=false

# IA — provider padrao: anthropic (Claude). Demais chaves sao opcionais/plugaveis.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
