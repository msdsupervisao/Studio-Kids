# Copie este arquivo para .env.local e preencha com suas credenciais de desenvolvimento.
# Nunca commite .env.local — ele ja esta no .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Armazenamento — "supabase" (padrao) ou "r2". So preencher R2_* quando mudar pra r2.
NEXT_PUBLIC_STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=
# Referencia de "espaco total" pro painel admin (R2 nao tem teto real) — padrao 10 (tier gratis do R2).
STORAGE_QUOTA_GB=10

MAINTENANCE_MODE=false

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
